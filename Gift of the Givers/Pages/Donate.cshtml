@page
@model Gift_of_the_Givers.Pages.DonateModel

@{
    ViewData["Title"] = "Donate";
}

<div class="donate-page">

    <!-- Donation Hero Section -->
    <section class="donate-hero">
        <div class="container text-center">

            <h1>Make a Difference</h1>

            <p>
                Your donation helps support communities affected by disasters
                and emergencies.
            </p>

        </div>
    </section>


    <!-- Donation Form Section -->
    <section class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="donation-card">

                    <h2 class="text-center mb-4">
                        Donation Details
                    </h2>

                    <form method="post">

                        <!-- Donation Type -->
                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                Donation Type
                            </label>

                            <div class="form-check">

                                <input class="form-check-input"
                                       type="radio"
                                       name="DonationType"
                                       id="oneTime"
                                       value="One-Time"
                                       checked />

                                <label class="form-check-label"
                                       for="oneTime">
                                    One-Time Donation
                                </label>

                            </div>


                            <div class="form-check">

                                <input class="form-check-input"
                                       type="radio"
                                       name="DonationType"
                                       id="recurring"
                                       value="Recurring" />

                                <label class="form-check-label"
                                       for="recurring">
                                    Recurring Donation
                                </label>

                            </div>

                        </div>


                        <!-- Donation Amount -->
                        <div class="mb-4">

                            <label class="form-label fw-bold"
                                   for="donationAmount">
                                Donation Amount (Minimum 1)
                            </label>

                            <input type="number"
                                   class="form-control"
                                   id="donationAmount"
                                   name="Amount"
                                   placeholder="Enter donation amount"
                                   min="1"
                                   step="0.01"
                                   required />

                            <div class="form-text">
                                Please enter an amount of 1 or more.
                            </div>

                        </div>


                        <!-- Currency -->
                        <div class="mb-4">

                            <label class="form-label fw-bold"
                                   for="currency">
                                Currency
                            </label>

                            <select class="form-select"
                                    id="currency"
                                    name="Currency"
                                    required>

                                <option value="">
                                    Select currency
                                </option>

                                <option value="ZAR">
                                    ZAR - South African Rand
                                </option>

                                <option value="USD">
                                    USD - US Dollar
                                </option>

                                <option value="EUR">
                                    EUR - Euro
                                </option>

                            </select>

                        </div>


                        <!-- Donor Name -->
                        <div class="mb-4">

                            <label class="form-label fw-bold"
                                   for="donorName">
                                Full Name
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="donorName"
                                   name="DonorName"
                                   placeholder="Enter your full name" />

                        </div>


                        <!-- Email Address -->
                        <div class="mb-4">

                            <label class="form-label fw-bold"
                                   for="donorEmail">
                                Email Address
                            </label>

                            <input type="email"
                                   class="form-control"
                                   id="donorEmail"
                                   name="Email"
                                   placeholder="Enter your email address" />

                        </div>


                        <!-- Anonymous Donation -->
                        <div class="form-check mb-4">

                            <input class="form-check-input"
                                   type="checkbox"
                                   id="anonymous"
                                   name="IsAnonymous"
                                   value="true" />

                            <label class="form-check-label"
                                   for="anonymous">
                                Donate anonymously
                            </label>

                        </div>


                        <!-- Submit Button -->
                        <button type="submit"
                                class="btn donate-submit-btn w-100">

                            Complete Donation

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </section>

</div>